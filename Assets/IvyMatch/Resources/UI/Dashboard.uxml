<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Dashboard.uss" />
    <ui:VisualElement name="root" class="root">

        <!-- One vertical scroll for the whole page. The tab bar and the school page sit outside it. -->
        <ui:ScrollView name="card-scroll" class="card-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">

            <ui:VisualElement class="app-bar">
                <ui:Label class="app-name" text="IvyMatch" />
                <ui:Button name="year-btn" class="year-btn" text="2027 입학" />
            </ui:VisualElement>

            <!-- Entry year picker (opened by the year button). -->
            <ui:VisualElement name="year-row" class="year-row hidden">
                <ui:Label class="year-row-label" text="입학 연도" />
                <ui:Button name="year-2027" class="chip" text="2027" />
                <ui:Button name="year-2028" class="chip" text="2028" />
                <ui:Button name="year-2029" class="chip" text="2029" />
                <ui:Button name="year-2030" class="chip" text="2030" />
            </ui:VisualElement>
            <ui:Label name="year-note" class="year-note hidden" text="" />

            <!-- List and map controls (hidden on the My scores tab). -->
            <ui:VisualElement name="list-controls" class="list-controls">
                <ui:Label name="header-title" class="header-title" text="미국 대학" />
                <ui:VisualElement class="header-sub-row">
                    <ui:VisualElement class="check-mark" />
                    <ui:Label name="header-sub" class="header-sub" text="" />
                </ui:VisualElement>

                <!-- Search row: FilterPanelView fills it (text field, clear, filter toggle). -->
                <ui:VisualElement name="search-bar" class="search-bar" />

                <!-- Acceptance-rate filter as one segmented control. -->
                <ui:VisualElement name="filter-bar" class="seg">
                    <ui:Button name="filter-all" class="seg-btn active" text="전체" />
                    <ui:Button name="filter-low" class="seg-btn" text="5% 미만" />
                    <ui:Button name="filter-mid" class="seg-btn" text="5–10%" />
                    <ui:Button name="filter-high" class="seg-btn" text="10% 초과" />
                </ui:VisualElement>

                <ui:VisualElement name="active-filters" class="active-filters hidden" />
                <ui:VisualElement name="filter-panel" class="filter-panel hidden" />
                <ui:Label name="summary-bar" class="summary-bar" text="" />
                <ui:Label name="empty-state" class="empty-state hidden" text="" />
            </ui:VisualElement>

            <!-- US map (map tab; UsMapView fills it). -->
            <ui:VisualElement name="map-view" class="map-view hidden" />

            <!-- My scores (score tab; ScoreView fills it). -->
            <ui:VisualElement name="score-view" class="score-view hidden" />

            <ui:VisualElement name="card-grid" class="card-grid" />
        </ui:ScrollView>

        <!-- Bottom tab bar -->
        <ui:VisualElement name="tab-bar" class="tab-bar">
            <ui:Button name="view-list" class="tab-btn active" text="목록" />
            <ui:Button name="view-map" class="tab-btn" text="지도" />
            <ui:Button name="view-score" class="tab-btn" text="내 점수" />
        </ui:VisualElement>

        <!-- School page: covers the screen when a school is opened. DetailPanelView fills detail-body. -->
        <ui:VisualElement name="detail-panel" class="page hidden">
            <ui:VisualElement class="page-bar">
                <ui:Button name="detail-close" class="back-btn">
                    <ui:VisualElement class="back-chevron" />
                    <ui:Label class="back-label" text="목록" />
                </ui:Button>
            </ui:VisualElement>
            <ui:ScrollView name="detail-scroll" class="page-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="detail-body" class="page-body" />
            </ui:ScrollView>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
