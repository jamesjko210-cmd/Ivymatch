/* ==========================================================================
   IvyMatch Dashboard.uss: light, Korean-first redesign.
   USS notes: no box-shadow, no gap, no grid. Spacing is done with margins.
   Font (IBM Plex Sans KR) is assigned to the root in code.
   ========================================================================== */

:root {
    --bg: #F3F5F7;
    --surface: #FFFFFF;
    --surface2: #EEF1F4;
    --seg: #E4E8ED;
    --border: #E2E6EB;
    --border2: #D5DBE2;
    --line: #EDF0F3;
    --text: #172033;
    --muted: #5B6474;
    --faint: #7A8392;
    --ok: #0A7A55;
    --warn: #C2410C;
    --warn-soft: #FDF1EA;
    --accent: #172033;
}

.root {
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: var(--bg);
    color: var(--text);
}

.unity-label {
    margin: 0;
    padding: 0;
    color: var(--text);
    white-space: normal;
}

/* --------------------------------------------------------------------------
   Page scroll + slim scrollbar (hidden on phones by the controller)
   -------------------------------------------------------------------------- */
.card-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}
#card-scroll .unity-scroller--vertical {
    position: absolute;
    top: 6px;
    bottom: 6px;
    right: 2px;
    width: 8px;
    min-width: 8px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
#card-scroll .unity-scroller--vertical .unity-scroller__low-button,
#card-scroll .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}
#card-scroll .unity-scroller--vertical .unity-scroller__slider {
    flex-grow: 1;
    width: 8px;
    min-width: 8px;
    margin: 0;
}
#card-scroll .unity-scroller--vertical .unity-base-slider__input {
    width: 8px;
    min-width: 8px;
}
#card-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    width: 8px;
    left: 0;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
#card-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    width: 4px;
    left: 2px;
    margin: 0;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(23, 32, 51, 0.2);
}
#card-scroll .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}

/* --------------------------------------------------------------------------
   Top: app name, entry year, title
   -------------------------------------------------------------------------- */
.app-bar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    margin: 16px 16px 0 16px;
}
.app-name {
    font-size: 16px;
    -unity-font-style: bold;
}
.year-btn {
    height: 36px;
    margin: 0;
    padding: 0 14px;
    font-size: 13px;
    color: var(--text);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 18px;
}
.year-btn:hover,
.year-btn:active,
.year-btn:focus {
    background-color: var(--surface2);
    border-color: var(--border2);
}
.year-row {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 12px 16px 0 16px;
}
.year-row-label {
    margin: 0 10px 6px 0;
    font-size: 12px;
    color: var(--muted);
}
.year-note {
    flex-shrink: 0;
    margin: 8px 16px 0 16px;
    font-size: 12px;
    color: var(--warn);
}

.list-controls {
    flex-shrink: 0;
}
.header-title {
    margin: 18px 16px 0 16px;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: -0.6px;
}
.header-sub-row {
    flex-direction: row;
    align-items: center;
    margin: 4px 16px 0 16px;
}
.header-sub {
    font-size: 14px;
    color: var(--muted);
}

/* Check mark drawn with two borders of a rotated box (the font has no ✓). */
.check-mark {
    width: 6px;
    height: 11px;
    margin: 0 9px 3px 3px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-right-color: var(--ok);
    border-bottom-color: var(--ok);
    rotate: 45deg;
    flex-shrink: 0;
}
.check-mark.small {
    width: 5px;
    height: 9px;
    margin: 0 7px 2px 2px;
}

/* --------------------------------------------------------------------------
   Search row + filter panel (FilterPanelView)
   -------------------------------------------------------------------------- */
.search-bar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 18px 16px 0 16px;
}
.search-wrap {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 120px;
    height: 48px;
}
.search-field {
    flex-grow: 1;
    margin: 0;
    height: 48px;
}
.search-field .unity-base-text-field__input,
.search-field .unity-text-field__input {
    padding: 0 14px;
    font-size: 15px;
    color: var(--text);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 12px;
    -unity-text-align: middle-left;
}
.search-field:focus .unity-base-text-field__input,
.search-field:focus .unity-text-field__input {
    border-color: var(--text);
}
.search-placeholder {
    position: absolute;
    left: 15px;
    right: 8px;
    top: 0;
    bottom: 0;
    font-size: 15px;
    color: var(--faint);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
}
.search-clear,
.filter-toggle {
    flex-shrink: 0;
    height: 48px;
    margin: 0 0 0 8px;
    padding: 0 14px;
    font-size: 14px;
    color: var(--text);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 12px;
}
.search-clear {
    width: 48px;
    padding: 0;
    font-size: 20px;
    -unity-text-align: middle-center;
}
.search-clear:hover,
.filter-toggle:hover,
.search-clear:active,
.filter-toggle:active,
.search-clear:focus,
.filter-toggle:focus {
    background-color: var(--surface2);
    border-color: var(--border2);
}
.filter-toggle.active,
.filter-toggle.active:hover,
.filter-toggle.active:active,
.filter-toggle.active:focus {
    color: #FFFFFF;
    background-color: var(--text);
    border-color: var(--text);
}
.active-filters {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px 16px 0 16px;
}
.filter-panel {
    flex-shrink: 0;
    margin: 12px 16px 0 16px;
    padding: 12px 16px 14px 16px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 14px;
}
.filter-cat-title {
    margin: 10px 0 6px 0;
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--muted);
}
.chip-row {
    flex-direction: row;
    flex-wrap: wrap;
}
.chip,
.filter-reset {
    margin: 0 6px 6px 0;
    padding: 7px 12px;
    font-size: 13px;
    color: var(--text);
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 16px;
}
.chip:hover,
.chip:active,
.chip:focus,
.filter-reset:hover,
.filter-reset:active,
.filter-reset:focus {
    background-color: var(--surface2);
    border-color: var(--border2);
}
.chip.active,
.chip.active:hover,
.chip.active:active,
.chip.active:focus {
    color: #FFFFFF;
    background-color: var(--text);
    border-color: var(--text);
}
.chip.chip-reset {
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--border);
}
.filter-reset {
    align-self: flex-start;
    margin: 12px 0 0 0;
}

/* --------------------------------------------------------------------------
   Segmented control (acceptance rate, SAT/ACT)
   -------------------------------------------------------------------------- */
.seg {
    flex-shrink: 0;
    flex-direction: row;
    height: 40px;
    margin: 12px 16px 0 16px;
    padding: 3px;
    background-color: var(--seg);
    border-radius: 12px;
}
.seg-btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    padding: 0;
    font-size: 13px;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 9px;
    -unity-text-align: middle-center;
}
.seg-btn:hover,
.seg-btn:active,
.seg-btn:focus {
    background-color: rgba(0, 0, 0, 0);
    color: var(--text);
}
.seg-btn.active,
.seg-btn.active:hover,
.seg-btn.active:active,
.seg-btn.active:focus {
    color: var(--text);
    background-color: var(--surface);
    -unity-font-style: bold;
}

/* --------------------------------------------------------------------------
   Summary / empty state
   -------------------------------------------------------------------------- */
.summary-bar {
    flex-shrink: 0;
    margin: 14px 16px 0 16px;
    font-size: 14px;
    color: var(--muted);
}
.empty-state {
    flex-shrink: 0;
    margin: 16px 16px 0 16px;
    padding: 24px 16px;
    font-size: 14px;
    color: var(--muted);
    -unity-text-align: middle-center;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 14px;
}

/* --------------------------------------------------------------------------
   School cards
   -------------------------------------------------------------------------- */
.card-grid {
    flex-direction: column;
    padding: 4px 16px 24px 16px;
}
.card-grid > TemplateContainer {
    flex-shrink: 0;
}
.card {
    flex-shrink: 0;
    margin-top: 10px;
    padding: 18px 18px 14px 18px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 16px;
}
.card.selected {
    border-color: var(--text);
}
.card-head {
    flex-direction: row;
    align-items: center;
}
.logo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #FFFFFF;
    background-color: var(--text);
    border-radius: 10px;
}
.card-titles {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 12px;
}
.school-name {
    font-size: 17px;
    -unity-font-style: bold;
}
.school-en {
    margin-top: 1px;
    font-size: 12px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.early-badge {
    flex-shrink: 0;
    margin-left: 8px;
    padding: 4px 8px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #3B4556;
    background-color: var(--surface2);
    border-radius: 6px;
}
.rate-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 12px;
}
.rate-value {
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: -1.5px;
}
.rate-unit {
    margin: 0 0 7px 2px;
    font-size: 22px;
    -unity-font-style: bold;
}
.rate-people {
    flex-shrink: 1;
    margin: 0 0 10px 10px;
    font-size: 13px;
    color: var(--muted);
}
.no-rate .rate-value {
    font-size: 32px;
    color: var(--muted);
}
.facts {
    flex-direction: row;
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: var(--line);
}
.fact {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
}
.fact-deadline {
    flex-grow: 1.25;
}
.fact-last {
    margin-right: 0;
}
.fact-label {
    font-size: 12px;
    color: var(--muted);
}
.fact-value {
    margin-top: 2px;
    font-size: 14px;
}
.fact-value-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}
.fact-value-row .fact-value {
    margin-top: 0;
    flex-shrink: 1;
}
.fact-dday {
    margin-right: 6px;
    font-size: 14px;
    -unity-font-style: bold;
}
.fact-dday.soon {
    color: var(--warn);
}
.card-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}
.footer-source {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    color: var(--ok);
}
.footer-source.unverified {
    color: var(--muted);
}
.footer-verified {
    flex-shrink: 0;
    font-size: 12px;
    color: var(--muted);
}

/* --------------------------------------------------------------------------
   Bottom tab bar
   -------------------------------------------------------------------------- */
.tab-bar {
    flex-shrink: 0;
    flex-direction: row;
    height: 60px;
    background-color: var(--surface);
    border-top-width: 1px;
    border-top-color: var(--border);
}
.tab-btn {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0;
    padding: 0;
    font-size: 14px;
    color: var(--faint);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-top-width: 2px;
    border-top-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    -unity-text-align: middle-center;
}
.tab-btn:hover,
.tab-btn:active,
.tab-btn:focus {
    background-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
}
.tab-btn.active,
.tab-btn.active:hover,
.tab-btn.active:active,
.tab-btn.active:focus {
    color: var(--text);
    -unity-font-style: bold;
    border-top-color: var(--text);
}

/* --------------------------------------------------------------------------
   School page (covers the screen; top/bottom set in code for the safe area)
   -------------------------------------------------------------------------- */
.page {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--bg);
}
.page-bar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding: 0 6px;
}
.back-btn {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin: 0;
    padding: 0 10px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.back-btn:hover,
.back-btn:active,
.back-btn:focus {
    background-color: rgba(0, 0, 0, 0);
}
.back-chevron {
    width: 10px;
    height: 10px;
    margin: 0 8px 0 6px;
    border-left-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--text);
    border-bottom-color: var(--text);
    rotate: 45deg;
}
.back-label {
    font-size: 15px;
    color: var(--muted);
}
.page-scroll {
    flex-grow: 1;
    flex-shrink: 1;
}
.page-body {
    padding: 4px 16px 32px 16px;
}
.page-head {
    flex-direction: row;
    align-items: center;
}
.page-logo {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 14px;
}
.page-titles {
    flex-shrink: 1;
    margin-left: 14px;
}
.page-title {
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: -0.5px;
}
.page-sub {
    font-size: 14px;
    color: var(--muted);
}
.page-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 14px;
}
.info-chip {
    margin: 0 6px 6px 0;
    padding: 5px 10px;
    font-size: 13px;
    background-color: #E8ECF0;
    border-radius: 8px;
}

.box {
    flex-shrink: 0;
    margin-top: 12px;
    padding: 18px 16px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 16px;
}
.box-rate {
    padding: 16px 16px 14px 16px;
}
.box-dates {
    padding: 14px 16px 12px 16px;
}
.box-title {
    font-size: 15px;
    -unity-font-style: bold;
}
.box-desc {
    margin-top: 4px;
    font-size: 13px;
    color: var(--muted);
}
.box-note {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
}

.page-rate-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 2px;
}
.page-rate {
    font-size: 44px;
    -unity-font-style: bold;
    letter-spacing: -1.5px;
}
.page-rate-unit {
    margin: 0 0 7px 2px;
    font-size: 22px;
    -unity-font-style: bold;
}
.page-rate-people {
    flex-shrink: 1;
    margin: 0 0 10px 10px;
    font-size: 13px;
    color: var(--muted);
}

.bar-line {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 8px;
}
.bar-name {
    font-size: 13px;
}
.bar-num {
    font-size: 13px;
    -unity-font-style: bold;
}
.box-majors .bar-line {
    margin-top: 10px;
}
.box-majors .bar-name,
.box-majors .bar-num {
    font-size: 14px;
}
.bar-track {
    height: 8px;
    margin-top: 4px;
    overflow: hidden;
    background-color: var(--line);
    border-radius: 4px;
}
.bar-thin {
    margin-top: 5px;
}
.bar-fill {
    height: 100%;
    border-radius: 4px;
}
.fill-ink {
    background-color: var(--text);
}
.fill-light {
    background-color: #CBD3DC;
}

.date-row {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
    padding: 8px 12px;
    background-color: var(--bg);
    border-radius: 10px;
}
.date-row.soon {
    background-color: var(--warn-soft);
}
.date-dday {
    width: 50px;
    flex-shrink: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--muted);
}
.date-dday.soon {
    color: var(--warn);
}
.date-day {
    flex-grow: 1;
    flex-shrink: 0;
    font-size: 14px;
    -unity-font-style: bold;
}
.date-round {
    flex-shrink: 1;
    margin-left: 8px;
    font-size: 12px;
    color: var(--muted);
    -unity-text-align: middle-right;
}

.money-row {
    flex-direction: row;
    margin-top: 12px;
}
.money-col {
    flex-grow: 1;
    flex-basis: 0;
}
.money-label {
    font-size: 13px;
    color: var(--muted);
}
.money-value {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: -0.5px;
}
.info-list {
    margin-top: 14px;
    border-top-width: 1px;
    border-top-color: var(--line);
}
.info-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}
.info-row.last {
    border-bottom-width: 0;
}
.info-key {
    flex-shrink: 1;
    font-size: 14px;
}
.info-val {
    flex-shrink: 0;
    margin-left: 12px;
    font-size: 14px;
    -unity-font-style: bold;
}
.info-val.ok {
    color: var(--ok);
}

.src-row {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    min-height: 32px;
    margin-top: 6px;
}
.src-link {
    font-size: 12px;
    color: var(--ok);
}

.cta {
    height: 52px;
    margin: 16px 0 0 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: #FFFFFF;
    background-color: var(--text);
    border-width: 0;
    border-radius: 14px;
}
.cta:hover,
.cta:active,
.cta:focus {
    background-color: #24304A;
}
.page-foot {
    margin-top: 10px;
    font-size: 12px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

/* --------------------------------------------------------------------------
   My scores (ScoreView)
   -------------------------------------------------------------------------- */
.score-view {
    flex-shrink: 0;
    margin: 0 16px 24px 16px;
}
.score-view .seg {
    margin: 18px 0 0 0;
}
.score-h1 {
    margin-top: 18px;
    font-size: 28px;
    -unity-font-style: bold;
    letter-spacing: -0.6px;
}
.score-lead {
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
}
.score-input-box {
    margin-top: 12px;
    padding: 14px 16px 10px 16px;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border2);
    border-radius: 14px;
}
.score-input-label {
    font-size: 13px;
    color: var(--muted);
}
.score-field {
    margin: 2px 0 0 0;
}
.score-field .unity-base-text-field__input,
.score-field .unity-text-field__input {
    height: 48px;
    padding: 0;
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--text);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    -unity-text-align: middle-left;
}
.tile-row {
    flex-direction: row;
    margin-top: 14px;
}
.tile {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    align-items: center;
    margin: 0 8px 0 0;
    padding: 10px 0 8px 0;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 12px;
}
.tile:hover,
.tile:active,
.tile:focus {
    background-color: var(--surface);
    border-color: var(--border2);
}
.tile.tile-last {
    margin-right: 0;
}
.tile.active,
.tile.active:hover,
.tile.active:active,
.tile.active:focus {
    border-width: 2px;
    border-color: var(--text);
}
.tile-num {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.tile-label {
    font-size: 12px;
    color: #3B4556;
    -unity-text-align: middle-center;
}
.score-summary {
    margin-top: 8px;
    font-size: 13px;
    color: var(--muted);
}
.score-view .box {
    margin-top: 14px;
}
.score-histo {
    flex-direction: row;
    align-items: flex-end;
    height: 96px;
    margin-top: 14px;
}
.score-bin {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 1px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
.score-axis {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}
.score-axis-label {
    font-size: 12px;
    color: var(--muted);
}
.score-axis-you {
    font-size: 12px;
    -unity-font-style: bold;
}
.score-legend {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}
.legend-band {
    width: 18px;
    height: 8px;
    margin-right: 6px;
    background-color: #9AA6B4;
    border-radius: 4px;
}
.legend-mark {
    width: 3px;
    height: 14px;
    margin: 0 6px 0 14px;
    background-color: var(--text);
    border-radius: 2px;
}
.legend-text {
    font-size: 12px;
    color: var(--muted);
}
.score-row {
    padding: 12px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}
.score-row-top {
    flex-direction: row;
    align-items: center;
}
.score-row-name {
    font-size: 14px;
    -unity-font-style: bold;
}
.score-row-range {
    flex-grow: 1;
    margin-left: 8px;
    font-size: 13px;
    color: var(--muted);
}
.score-row-status {
    font-size: 12px;
    -unity-font-style: bold;
}
.score-track {
    position: relative;
    height: 16px;
    margin-top: 8px;
    background-color: var(--line);
    border-radius: 8px;
}
.score-band {
    position: absolute;
    top: 3px;
    height: 10px;
    border-radius: 5px;
}
.score-marker {
    position: absolute;
    top: -2px;
    width: 3px;
    height: 20px;
    margin-left: -1px;
    background-color: var(--text);
    border-radius: 2px;
}
.score-more {
    padding-top: 12px;
    font-size: 13px;
    color: var(--muted);
}
.score-caption {
    margin-top: 14px;
    font-size: 12px;
    color: var(--muted);
}

/* --------------------------------------------------------------------------
   US map (UsMapView)
   -------------------------------------------------------------------------- */
.map-view {
    flex-shrink: 0;
    margin: 12px 16px 16px 16px;
}
.map-regions {
    margin-bottom: 6px;
}
.map-surface {
    position: relative;
    width: 100%;
    height: 300px;
    overflow: hidden;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 14px;
}
.map-markers {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}
.map-anchor {
    position: absolute;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.map-marker {
    margin: 0;
    padding: 0 5px;
    height: 20px;
    min-width: 22px;
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    border-width: 1px;
    border-color: #FFFFFF;
    border-radius: 5px;
}
.map-marker.selected {
    border-width: 2px;
    border-color: var(--text);
    scale: 1.2 1.2;
}
.map-cluster {
    margin: 0;
    padding: 0;
    width: 24px;
    height: 24px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #FFFFFF;
    background-color: var(--text);
    border-width: 2px;
    border-color: #FFFFFF;
    border-radius: 12px;
}
.map-cluster.selected {
    border-color: var(--warn);
}
.map-dot {
    width: 6px;
    height: 6px;
    background-color: var(--text);
    border-radius: 3px;
}
.map-caption {
    margin-top: 6px;
    font-size: 12px;
    color: var(--muted);
}

/* Must stay last so it wins over display defaults above. */
.hidden {
    display: none;
}
