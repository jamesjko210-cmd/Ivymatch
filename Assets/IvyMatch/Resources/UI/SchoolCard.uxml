<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="card-root" class="card">

        <ui:VisualElement class="card-head">
            <ui:Label name="logo" class="logo" text="HU" />
            <ui:VisualElement class="card-titles">
                <ui:Label name="school-name" class="school-name" text="School" />
                <ui:Label name="school-en" class="school-en" text="" />
            </ui:VisualElement>
            <ui:Label name="early-badge" class="early-badge" text="ED" />
        </ui:VisualElement>

        <ui:VisualElement class="rate-row">
            <ui:Label name="rate-value" class="rate-value" text="—" />
            <ui:Label name="rate-unit" class="rate-unit" text="%" />
            <ui:Label name="rate-people" class="rate-people" text="" />
        </ui:VisualElement>

        <ui:VisualElement class="facts">
            <ui:VisualElement class="fact fact-deadline">
                <ui:Label class="fact-label" text="다음 마감" />
                <ui:VisualElement class="fact-value-row">
                    <ui:Label name="fact-dday" class="fact-dday" text="" />
                    <ui:Label name="fact-date" class="fact-value" text="—" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="fact">
                <ui:Label class="fact-label" text="연간 총비용" />
                <ui:Label name="fact-cost" class="fact-value" text="—" />
            </ui:VisualElement>
            <ui:VisualElement class="fact fact-last">
                <ui:Label class="fact-label" text="국제학생 심사" />
                <ui:Label name="fact-aid" class="fact-value" text="—" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="card-footer">
            <ui:VisualElement name="footer-check" class="check-mark small" />
            <ui:Label name="footer-source" class="footer-source" text="" />
            <ui:Label name="footer-verified" class="footer-verified" text="" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
